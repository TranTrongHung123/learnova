POSTGRES_HOST=localhost
POSTGRES_DB=learnova
POSTGRES_USER=learnova
POSTGRES_PASSWORD=<YOUR_LOCAL_POSTGRES_PASSWORD>
POSTGRES_PORT=5432
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
SERVER_PORT=8080
# Generate a private base64 secret containing at least 32 random bytes.
JWT_SECRET=<YOUR_BASE64_32_BYTE_SECRET>
JWT_ISSUER=learnova
AUTH_COOKIE_SECURE=false
AUTH_ALLOWED_ORIGINS=http://localhost:3000
# Google OAuth Web application; secrets remain backend-only.
GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/google/callback
GOOGLE_FRONTEND_URL=http://localhost:3000
