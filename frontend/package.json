{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:integration": "playwright test --config tests/config/playwright.integration.config.ts",
    "test:auth": "npm run test:integration -- --project=auth",
    "test:classroom": "npm run test:integration -- --project=classroom",
    "test:question": "npm run test:integration -- --project=question",
    "test:import": "npm run test:integration -- --project=import",
    "test:session": "npm run test:integration -- --project=session",
    "test:discovery": "npm run test:integration -- --project=discovery",
    "test:attempt": "npm run test:integration -- --project=attempt",
    "test:notification": "npm run test:integration -- --project=notification",
    "test:dashboard": "playwright test --config tests/config/playwright.dashboard.config.ts",
    "test:admin": "playwright test --config tests/config/playwright.admin.config.ts",
    "test:result": "npm run test:integration -- --project=result",
    "test:monitoring": "npm run test:integration -- --project=monitoring",
    "test:exam": "npm run test:integration -- --project=exam",
    "test:google": "playwright test --config tests/config/playwright.google.config.ts",
    "test:production": "playwright test --config tests/config/playwright.production.config.ts",
    "test:health": "vitest run --config tests/config/vitest.health.config.mts"
  },
  "dependencies": {
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.2"
  }
}
