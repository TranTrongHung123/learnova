{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:auth": "playwright test --config playwright.auth.config.ts",
    "test:classroom": "playwright test --config playwright.classroom.config.ts",
    "test:question": "playwright test --config playwright.question.config.ts",
    "test:import": "playwright test --config playwright.import.config.ts",
    "test:session": "playwright test --config playwright.session.config.ts",
    "test:discovery": "playwright test --config playwright.discovery.config.ts",
    "test:attempt": "playwright test --config playwright.attempt.config.ts",
    "test:notification": "playwright test --config playwright.notification.config.ts",
    "test:result": "playwright test --config playwright.result.config.ts",
    "test:monitoring": "playwright test --config playwright.monitoring.config.ts",
    "test:exam": "playwright test --config playwright.exam.config.ts",
    "test:google": "playwright test --config playwright.google.config.ts",
    "test:production": "playwright test --config playwright.production.config.ts",
    "test:health": "vitest run --config vitest.health.config.mts"
  },
  "dependencies": {
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.2"
  }
}
